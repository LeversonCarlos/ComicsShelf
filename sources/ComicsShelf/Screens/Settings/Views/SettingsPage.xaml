<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
   xmlns="http://xamarin.com/schemas/2014/forms"
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
   x:Class="ComicsShelf.Screens.Settings.SettingsPage"
   Title="{Binding Title}" >

   <ContentPage.Resources>

      <Style TargetType="StackLayout" x:Key="Settings_Main_Stack">
         <Setter Property="Padding" Value="10" />
      </Style>

      <Style TargetType="StackLayout" x:Key="Settings_Group_Stack">
         <Setter Property="Margin" Value="0,10" />
      </Style>

      <Style TargetType="FlexLayout" x:Key="Settings_Item_Flex">
         <Setter Property="Padding" Value="10,5" />
         <Setter Property="AlignItems" Value="Center" />
         <Setter Property="MinimumHeightRequest" Value="60" />
      </Style>

      <Style TargetType="ProgressBar" x:Key="Settings_Library_Progress" BasedOn="{StaticResource ProgressBar}">
         <Setter Property="BackgroundColor" Value="{StaticResource SeparatorColor}" />
         <Setter Property="Opacity" Value="0.3" />
      </Style>

   </ContentPage.Resources>

   <ContentPage.Content>
      <StackLayout Style="{StaticResource Settings_Main_Stack}">

         <StackLayout BindableLayout.ItemsSource="{Binding LibraryTypes}" >
            <BindableLayout.ItemTemplate>
               <DataTemplate>
                  <StackLayout Style="{StaticResource Settings_Group_Stack}" >

                     <Label Text="{Binding Title}" Style="{StaticResource Large}" />

                     <StackLayout BindableLayout.ItemsSource="{Binding Libraries}">
                        <BindableLayout.ItemTemplate>
                           <DataTemplate>

                              <FlexLayout Style="{StaticResource Settings_Item_Flex}" >
                                 <StackLayout FlexLayout.Grow="1" Spacing="0">
                                    <Label Text="{Binding Library.Description}" Style="{StaticResource Default}" ></Label>
                                    <Label Text="{Binding Library.Path}" Style="{StaticResource Small}" ></Label>
                                    <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" Style="{StaticResource Micro}" ></Label>
                                    <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding HasProgress}" Style="{StaticResource Settings_Library_Progress}" ></ProgressBar>
                                 </StackLayout>
                                 <ImageButton Command="{Binding RemoveCommand}" Source="delete" />
                              </FlexLayout>

                           </DataTemplate>
                        </BindableLayout.ItemTemplate>
                     </StackLayout>

                     <FlexLayout Style="{StaticResource Settings_Item_Flex}">
                        <FlexLayout.GestureRecognizers>
                           <TapGestureRecognizer Command="{Binding AddCommand}" />
                        </FlexLayout.GestureRecognizers>
                        <Label Text="{Binding AddText}" Style="{StaticResource Default}"></Label>
                     </FlexLayout>

                     <BoxView Style="{StaticResource Separator}" />

                  </StackLayout>
               </DataTemplate>
            </BindableLayout.ItemTemplate>
         </StackLayout>

         <StackLayout Style="{StaticResource Settings_Group_Stack}">

            <Label Text="{Binding LOCAL_CACHE_TITLE}" Style="{StaticResource Large}" />

            <FlexLayout Style="{StaticResource Settings_Item_Flex}" >
               <FlexLayout.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding ClearCacheCommand}" />
               </FlexLayout.GestureRecognizers>

               <StackLayout FlexLayout.Grow="1" Spacing="0">
                  <Label Text="{Binding LOCAL_CACHE_CLEAR_COMMAND}" Style="{StaticResource Default}" ></Label>
                  <Label Style="{StaticResource Small}" >
                     <Label.FormattedText>
                        <FormattedString>
                           <FormattedString.Spans>
                              <Span Text="{Binding CacheSizeInMegas}" />
                              <Span Text=" " />
                              <Span Text="{Binding LOCAL_CACHE_UNITS}" />
                           </FormattedString.Spans>
                        </FormattedString>
                     </Label.FormattedText>
                  </Label>
               </StackLayout>

            </FlexLayout>

            <BoxView Style="{StaticResource Separator}" />

         </StackLayout>

      </StackLayout>
   </ContentPage.Content>

</ContentPage>