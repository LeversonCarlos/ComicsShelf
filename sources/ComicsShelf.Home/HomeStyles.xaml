<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    x:Class="ComicsShelf.Home.HomeStyles">

   <Style TargetType="StackLayout" x:Key="MainStack">
      <Setter Property="Padding" Value="10" />
      <Setter Property="Spacing" Value="10" />
   </Style>

   <Style TargetType="CollectionView" x:Key="SectionsCollection">
      <Setter Property="ItemsLayout" Value="VerticalList" />
      <Setter Property="SelectionMode" Value="None" />
      <Setter Property="ItemSizingStrategy" Value="MeasureFirstItem" />
   </Style>

   <Style TargetType="StackLayout" x:Key="FolderStack">
      <Setter Property="Margin" Value="0,0,0,20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Spacing" Value="5" />
   </Style>

   <Style TargetType="Label" x:Key="FolderTitle">
      <Setter Property="FontSize" Value="Medium" />
      <Setter Property="TextColor" Value="Blue" />
   </Style>

</ResourceDictionary>